# Which LLM provider to use: anthropic | openai | openrouter | ollama
PROVIDER=anthropic

# Model for paragraph translation. Leave blank to use the provider's default
# (see DEFAULT_MODEL in biread/config.py).
#   anthropic  — claude-sonnet-4-6 (default), claude-opus-4-8, claude-haiku-4-5
#   openrouter — ids are namespaced, e.g. anthropic/claude-sonnet-4.6
# Note: models with adaptive thinking on by default (claude-sonnet-5, the Opus
# 4.x line) spend thinking tokens on every batch. Translation does not need
# them, so the Sonnet 4.6 default is both cheaper and faster here.
MODEL_TRANSLATE=

# Model for glossing. Defaults to MODEL_TRANSLATE above, because glossing is
# less mechanical than it looks — passé composé auxiliaries and agreement,
# irregular infinitives, and surfaces copied character for character. Set a
# cheaper model here if you would rather trade accuracy for spend.
MODEL_GLOSS=

# --- API keys: set the one matching PROVIDER above ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Ollama runs locally and needs no key. Only set this if it is not on the default host.
OLLAMA_HOST=http://localhost:11434

# Hard cap in USD on a single run's estimated spend. The run stops cleanly once
# it is crossed and keeps everything already cached, so you can raise the cap
# and resume rather than losing progress.
MAX_COST_USD=2.00

# The cap can only be enforced for models biread has pricing for. For anything
# else — a local model, a new release, a gateway with its own rates — give it
# the price yourself as "<input>,<output>" USD per million tokens.
# PRICE_PER_MTOK=3.0,15.0
