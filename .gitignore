# Environment / secrets
.env

# Generated data — the cache is the expensive, rebuildable asset (see README)
cache/
output/

# Book source texts — bring your own, legally-obtained copies
*.txt
*.pdf
*.epub

# Python
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/

# The rules above would also hide files we DO want to track — carve out exceptions
!requirements.txt
!examples/**/*.txt
# The bundled font's licence. The OFL requires it to travel with the font, and a
# book inlines the font, so this must be tracked — `*.txt` above would drop it.
!biread/assets/fonts/*.txt

# local-only design handoff — never publish
design-reference/ui-rebuild-brief.md
design-reference/current-ui-snapshot.md
design-reference/shelf-brief.md

# Finder leaves these in every folder it opens; they carry local metadata and
# nothing the repo wants. None has ever been committed — this keeps it that way.
.DS_Store

# Per-machine tooling: local permissions, a dev-server config pointing at paths
# only this machine has, and `worktrees/`, which holds live git worktrees — a
# whole second checkout of this repo. None of it is the project.
.claude/

# Screenshots the spot-check leaves beside a book: evidence for one approval,
# not part of the project.
web/books/checks/
